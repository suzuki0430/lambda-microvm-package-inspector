  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@types/node": "24.0.15",
    "aws-cdk": "2.1132.0",
    "eslint": "9.31.0",
    "prettier": "3.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vitest": "3.2.6"
  },
  "packageManager": "pnpm@10.11.0",
