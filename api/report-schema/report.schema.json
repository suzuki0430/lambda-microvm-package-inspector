{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/package-inspection-report-v1.json",
  "title": "Package Inspection Report",
  "description": "Deterministic evidence collected from a bounded npm installation in an isolated Lambda MicroVM.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scan",
    "subject",
    "artifact",
    "environment",
    "staticAnalysis",
    "dynamicAnalysis",
    "sbom",
    "limits",
    "execution"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startedAt", "finishedAt", "runnerVersion", "policyVersion"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "runnerVersion": { "type": "string", "maxLength": 64 },
        "policyVersion": { "const": "npm-demo-v1" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "name", "version"],
      "properties": {
        "ecosystem": { "const": "npm" },
        "name": { "type": "string", "minLength": 1, "maxLength": 214 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "sizeBytes", "integrityVerified"],
      "properties": {
        "filename": { "type": "string", "maxLength": 255 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "integrityVerified": { "type": "boolean" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "operatingSystem", "pythonVersion", "nodeVersion", "npmVersion"],
      "properties": {
        "architecture": { "type": "string", "maxLength": 32 },
        "operatingSystem": { "type": "string", "maxLength": 128 },
        "pythonVersion": { "type": "string", "maxLength": 64 },
        "nodeVersion": { "type": "string", "maxLength": 64 },
        "npmVersion": { "type": "string", "maxLength": 64 },
        "microvmImageVersion": { "type": "string", "maxLength": 256 }
      }
    },
    "staticAnalysis": { "$ref": "#/$defs/staticAnalysis" },
    "dynamicAnalysis": { "$ref": "#/$defs/dynamicAnalysis" },
    "sbom": {
      "type": "object",
      "additionalProperties": true,
      "required": ["bomFormat", "specVersion", "version", "metadata", "components"],
      "properties": {
        "bomFormat": { "const": "CycloneDX" },
        "specVersion": { "type": "string", "maxLength": 16 },
        "version": { "type": "integer", "minimum": 1 },
        "metadata": { "type": "object", "additionalProperties": true },
        "components": { "type": "array", "maxItems": 10000, "items": { "type": "object", "additionalProperties": true } }
      }
    },
    "limits": { "$ref": "#/$defs/limits" },
    "execution": { "$ref": "#/$defs/execution" }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "maxItems": 10000,
      "items": { "type": "string", "maxLength": 4096 }
    },
    "event": {
      "type": "object",
      "maxProperties": 32,
      "required": ["eventId", "type", "evidenceType"],
      "properties": {
        "eventId": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "maxLength": 64 },
        "evidenceType": { "type": "string", "maxLength": 64 }
      },
      "additionalProperties": true
    },
    "staticAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageMetadata", "files", "lifecycleScripts", "directDependencies", "license", "patterns", "archiveWarnings"],
      "properties": {
        "packageMetadata": { "type": "object", "maxProperties": 64, "additionalProperties": true },
        "files": { "$ref": "#/$defs/stringArray" },
        "lifecycleScripts": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 4096 } },
        "directDependencies": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 256 } },
        "license": { "type": ["string", "null"], "maxLength": 256 },
        "patterns": { "type": "array", "maxItems": 1000, "items": { "type": "object", "additionalProperties": true } },
        "archiveWarnings": { "$ref": "#/$defs/stringArray" }
      }
    },
    "dynamicAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystem", "processes", "fileAccesses", "dns", "network", "environmentReads", "resources", "output"],
      "properties": {
        "filesystem": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/event" } },
        "processes": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/event" } },
        "fileAccesses": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/event" } },
        "dns": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/event" } },
        "network": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/event" } },
        "environmentReads": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/event" } },
        "resources": { "type": "object", "maxProperties": 32, "additionalProperties": true },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stdout", "stderr"],
          "properties": {
            "stdout": { "$ref": "#/$defs/capturedOutput" },
            "stderr": { "$ref": "#/$defs/capturedOutput" }
          }
        }
      }
    },
    "capturedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "capturedBytes", "observedBytes", "truncated", "capturedSHA256"],
      "properties": {
        "text": { "type": "string", "maxLength": 131072 },
        "capturedBytes": { "type": "integer", "minimum": 0 },
        "observedBytes": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "capturedSHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutSeconds", "cpuSeconds", "stdoutBytes", "stderrBytes", "processes", "fileBytes"],
      "properties": {
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "cpuSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "stdoutBytes": { "type": "integer", "minimum": 1024 },
        "stderrBytes": { "type": "integer", "minimum": 1024 },
        "processes": { "type": "integer", "minimum": 1 },
        "fileBytes": { "type": "integer", "minimum": 1024 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "exitCode", "timedOut", "killedForOutputLimit", "errors"],
      "properties": {
        "outcome": { "enum": ["succeeded", "failed", "timed-out", "killed", "internal-error"] },
        "exitCode": { "type": ["integer", "null"] },
        "timedOut": { "type": "boolean" },
        "killedForOutputLimit": { "type": "boolean" },
        "errors": { "$ref": "#/$defs/stringArray" }
      }
    }
  }
}
