#!/usr/bin/env bash
set -euo pipefail

# Usage: AWS_REGION=ap-northeast-1 ./scripts/verify-cleanup
# Description: Fails when any Lambda MicroVM has not reached TERMINATED.
# Returns: 0 when no billable MicroVM remains; 1 when cleanup is incomplete.

readonly AWS_REGION="${AWS_REGION:-ap-northeast-1}"

if ! aws lambda-microvms help >/dev/null 2>&1; then
  echo "AWS CLI does not include lambda-microvms; upgrade AWS CLI v2." >&2
  exit 1
fi

active_count="$(
  aws lambda-microvms list-microvms \
    --region "${AWS_REGION}" \
    --query "length(items[?state!='TERMINATED'])" \
    --output text
)"

if [[ "${active_count}" != "0" ]]; then
  echo "cleanup incomplete: ${active_count} MicroVM(s) are not TERMINATED" >&2
  aws lambda-microvms list-microvms \
    --region "${AWS_REGION}" \
    --query "items[?state!='TERMINATED'].[microvmId,state,imageArn,startedAt]" \
    --output table >&2
  exit 1
fi

echo "Cleanup verified: no active or suspended Lambda MicroVMs in ${AWS_REGION}."
